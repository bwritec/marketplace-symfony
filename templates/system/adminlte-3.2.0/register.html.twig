{% extends 'system/adminlte-3.2.0/layouts/auth.html.twig' %}

{% block content %}
    {% set title = APP_NAME|replace({' ': ''}) %}

    {% set title_with_subtitle = false %}
    {% set title_first = title %}
    {% set title_last = '' %}

    {% if title matches '/(?<!^)[A-Z]/' %}
        {% set split_index = null %}

        {% for i in 1..(title|length - 1) %}
            {% if title[i] matches '/[A-Z]/' and split_index is null %}
                {% set split_index = i %}
            {% endif %}
        {% endfor %}

        {% if split_index is not null %}
            {% set title_first = title|slice(0, split_index) %}
            {% set title_last = title|slice(split_index) %}
            {% set title_with_subtitle = true %}
        {% endif %}
    {% endif %}

    <div class="register-box">
        <div class="register-logo">
            <a href="{{ path('home') }}">
                <b>{{ title_with_subtitle ? title_first : title }}</b>{{ title_with_subtitle ? title_last : '' }}
            </a>
        </div>

        <div class="card">
            <div class="card-body register-card-body">
                <p class="login-box-msg">
                    Crie uma nova conta
                </p>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success mb-3" role="alert">
                        {{ message }}
                    </div>
                {% endfor %}

                <form action="{{ path('register_store') }}" method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('register') }}">

                    <div class="mb-3">
                        <label class="form-label mb-0">
                            Nome completo
                        </label>

                        <div class="input-group">
                            <input
                                type="text"
                                class="form-control {{ errors.name is defined ? 'is-invalid' : '' }}"
                                name="name"
                                value="{{ old.name|default('') }}"
                            >

                            <div class="input-group-append">
                                <div class="input-group-text">
                                    <span class="fas fa-user"></span>
                                </div>
                            </div>

                            {% if errors.name is defined %}
                                <div class="invalid-feedback">
                                    {{ errors.name }}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label mb-0">
                            Email
                        </label>

                        <div class="input-group">
                            <input
                                type="email"
                                class="form-control {{ errors.email is defined ? 'is-invalid' : '' }}"
                                name="email"
                                value="{{ old.email|default('') }}"
                            >

                            <div class="input-group-append">
                                <div class="input-group-text">
                                    <span class="fas fa-envelope"></span>
                                </div>
                            </div>

                            {% if errors.email is defined %}
                                <div class="invalid-feedback">
                                    {{ errors.email }}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label mb-0">
                            CPF
                        </label>

                        <div class="input-group">
                            <input
                                type="text"
                                id="cpf"
                                class="form-control {{ errors.cpf is defined ? 'is-invalid' : '' }}"
                                name="cpf"
                                maxlength="14"
                                value="{{ old.cpf|default('') }}"
                            >

                            <div class="input-group-append">
                                <div class="input-group-text">
                                    <i class="fas fa-passport"></i>
                                </div>
                            </div>

                            {% if errors.cpf is defined %}
                                <div class="invalid-feedback">
                                    {{ errors.cpf }}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label mb-0">
                            Senha
                        </label>

                        <div class="input-group">
                            <input
                                type="password"
                                class="form-control {{ errors.password is defined ? 'is-invalid' : '' }}"
                                name="password"
                                placeholder="Senha"
                            >

                            <div class="input-group-append">
                                <div class="input-group-text">
                                    <span class="fas fa-lock"></span>
                                </div>
                            </div>

                            {% if errors.password is defined %}
                                <div class="invalid-feedback">
                                    {{ errors.password }}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-4">
                            <button type="submit" class="btn btn-primary btn-block">
                                Cadastrar
                            </button>
                        </div>
                    </div>
                </form>

                <a href="{{ path('login') }}" class="text-center">
                    Já tenho uma conta
                </a>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        document.getElementById('cpf').addEventListener('input', function (e)
        {
            let value = e.target.value.replace(/\D/g, '');

            if (value.length > 11)
            {
                value = value.slice(0, 11);
            }

            value = value.replace(/(\d{3})(\d)/, '$1.$2');
            value = value.replace(/(\d{3})(\d)/, '$1.$2');
            value = value.replace(/(\d{3})(\d{1,2})$/, '$1-$2');

            e.target.value = value;
        });
    </script>
{% endblock %}
