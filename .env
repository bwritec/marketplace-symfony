# Em todos os ambientes, os seguintes arquivos são
# carregados, caso existam, sendo que o último tem
# precedência sobre o primeiro:
#
#  * .env                Contém valores padrão para as variáveis de ambiente necessárias para o aplicativo.
#  * .env.sample         A kwrite usa o .env.sample para gerar um .env
#  * .env.local          Arquivo não confirmado com substituições locais
#  * .env.$APP_ENV       padrões específicos do ambiente comprometidos
#  * .env.$APP_ENV.local substituições específicas do ambiente não confirmadas
#
# Variáveis de ambiente reais são superiores a arquivos .env.
#
# NÃO DEFINA SEGREDOS DE PRODUÇÃO NESTE ARQUIVO NEM EM QUALQUER OUTRO ARQUIVO CONFIRMADO.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Execute "composer dump-env prod" para compilar arquivos .env para uso em produção (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_NAME=Marketplace
APP_RATE=15
APP_BASEURL=http://marketplace-symfony.com.br
APP_SECRET=a9ffce800fff58b49e9550917146af84654b7fec393243fac47c642d7bc84bc8
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> kwrite/themes ###
APP_THEME=essentials
APP_THEME_COLOR=yellow
APP_THEME_SYSTEM=adminlte-3.2.0
###< kwrite/themes ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
